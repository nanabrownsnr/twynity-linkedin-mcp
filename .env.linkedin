# LinkedIn OAuth MCP Server Configuration

# MongoDB connection for storing encrypted connections
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=linkedin_mcp

# Encryption key for securely storing credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Twynity account service details
ACCOUNT_SERVICE_URL=https://accounts.twynity.com
ACCOUNT_SERVICE_JWKS_ENDPOINT=/oauth2/keys
ACCOUNT_SERVICE_JWKS_CACHE_TTL=300

# License service details
LICENSE_KEY=
LICENSE_SERVER_BASE_URL=https://license.twynity.com
LICENSE_SERVER_JWKS_ENDPOINT=/oauth2/keys
LICENSE_SERVER_ACTIVATION_ENDPOINT=/activate

# Usage reporting endpoint
USAGE_REPORT_ENDPOINT=https://usage.twynity.com/api/v1/report

# Public URL for the server
PUBLIC_URL=http://localhost:8000

# Environment (development, staging, production)
ENVIRONMENT=development

# Allowed origins for CORS
ALLOWED_ORIGINS=*

# --- LinkedIn OAuth 2.0 external connection (Interconnector §10.3) ---
# Provider segment in /api/v1/auth/{provider}/...
OAUTH_PROVIDER=linkedin

# Your LinkedIn Developer app credentials
# Get these from: https://www.linkedin.com/developers/apps/
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# The redirect URI Twynity provides. MUST exactly match what you registered
# with LinkedIn Developer Portal
# For development: http://localhost:3000/oauth/callback
# For production: https://your-twynity-deployment/oauth/callback
OAUTH_REDIRECT_URI=

# LinkedIn OAuth endpoints + scopes
# Authorization URL: https://www.linkedin.com/oauth/v2/authorization
# Token URL: https://www.linkedin.com/oauth/v2/accessToken
OAUTH_AUTHORIZE_URL=https://www.linkedin.com/oauth/v2/authorization
OAUTH_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
OAUTH_REVOKE_URL=https://www.linkedin.com/oauth/v2/revoke

# Required OAuth scopes for LinkedIn
# r_liteprofile - Read profile info
# r_emailaddress - Email address
# w_member_social - Post, comment, share
OAUTH_SCOPES=r_liteprofile r_emailaddress w_member_social

# OAuth session TTL in seconds
OAUTH_SESSION_TTL_SECONDS=600
